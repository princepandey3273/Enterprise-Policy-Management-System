:root {
    --bg-obsidian: #0A0B0D;
    --bg-graphite: #161B22;
    --bg-surface: #1C2128;
    --border-steel: #30363D;
    --text-primary: #F0F4F8;
    --text-secondary: #8B949E;
    --accent-blue: #3B82F6;
    --accent-hover: #2563EB;
    --success-green: #238636;
    --font-main: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', 'IBM Plex Mono', monospace;
}

* {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
}

body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-obsidian);
    color: var(--text-primary);
    font-family: var(--font-main);
}

.app-container {
    display: grid;
    grid-template-columns: 300px 1fr;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
}

/* Sidebar */
.sidebar {
    background-color: var(--bg-graphite);
    border-right: 1px solid var(--border-steel);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
}

.sidebar-header {
    margin-bottom: 40px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
}

.logo-icon {
    background: var(--accent-blue);
    color: white;
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
}

.logo-text {
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.5px;
}

.version-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
}

.sidebar-content {
    flex-grow: 1;
}

.section-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
}

/* The CUSTOM File Upload Fix */
.custom-file-upload {
    margin-bottom: 20px;
}

.hidden-input {
    display: none !important;
}

.upload-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border: 1px dashed var(--border-steel);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    background: var(--bg-obsidian);
}

.upload-box:hover {
    border-color: var(--accent-blue);
    background: var(--bg-surface);
}

.upload-box i {
    font-size: 1.5rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
}

.upload-box span {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 4px;
}

.upload-box small {
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.btn-index {
    width: 100%;
    padding: 12px;
    background: var(--accent-blue);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.btn-index:hover {
    background: var(--accent-hover);
}

.status-message {
    margin-top: 12px;
    font-size: 0.8rem;
    text-align: center;
    color: var(--text-secondary);
}

/* Stats */
.stats-section {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border-steel);
}

.stat-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.85rem;
}

.stat-label { color: var(--text-secondary); }
.stat-value { font-family: var(--font-mono); font-weight: 500; }

/* Footer */
.sidebar-footer {
    padding-top: 20px;
    border-top: 1px solid var(--border-steel);
}

.user-profile {
    display: flex;
    align-items: center;
    gap: 12px;
}

.avatar {
    width: 32px;
    height: 32px;
    background: var(--border-steel);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
}

.user-info {
    display: flex;
    flex-direction: column;
}

.user-name { font-size: 0.85rem; font-weight: 600; }
.user-role { font-size: 0.7rem; color: var(--text-secondary); }

/* Main Content Area */
.main-content {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-obsidian);
}

.top-nav {
    height: 64px;
    border-bottom: 1px solid var(--border-steel);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: var(--bg-graphite);
}

.nav-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.online-indicator {
    font-size: 0.75rem;
    color: var(--success-green);
    font-weight: 500;
}

.chat-window {
    flex-grow: 1;
    overflow-y: auto;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* Messages */
.message {
    display: flex;
    flex-direction: column;
    max-width: 800px;
}

.message.bot { align-self: flex-start; }
.message.user { align-self: flex-end; }

.msg-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-bottom: 6px;
    text-transform: uppercase;
}

.msg-content {
    padding: 12px 16px;
    border-radius: 0 12px 12px 12px;
    font-size: 0.95rem;
    line-height: 1.6;
}

.bot .msg-content {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-steel);
    border-bottom-left-radius: 0;
}

.user .msg-content {
    background: var(--accent-blue);
    color: white;
    border-bottom-right-radius: 0;
}

/* Input Area */
.chat-input-area {
    padding: 24px;
    background: var(--bg-graphite);
    border-top: 1px solid var(--border-steel);
}

.input-wrapper {
    display: flex;
    gap: 12px;
    max-width: 800px;
    margin: 0 auto;
}

.input-wrapper input {
    flex-grow: 1;
    background: var(--bg-obsidian);
    border: 1px solid var(--border-steel);
    border-radius: 8px;
    padding: 14px 18px;
    color: white;
    font-family: var(--font-main);
    outline: none;
    transition: border-color 0.2s;
}

.input-wrapper input:focus {
    border-color: var(--accent-blue);
}

.send-btn {
    background: var(--accent-blue);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0 20px;
    cursor: pointer;
    transition: background 0.2s;
}

.send-btn:hover {
    background: var(--accent-hover);
}

.input-footer {
    display: flex;
    justify-content: space-between;
    max-width: 800px;
    margin: 8px auto 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-secondary);
}

/* Scrollbar */
.chat-window::-webkit-scrollbar { width: 6px; }
.chat-window::-webkit-scrollbar-track { background: transparent; }
.chat-window::-webkit-scrollbar-thumb { background: var(--border-steel); border-radius: 10px; }

/* Responsive */
@media (max-width: 992px) {
    .app-container {
        grid-template-columns: 1fr;
    }
    .sidebar {
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--border-steel);
    }
    .main-content {
        height: calc(100vh - 300px);
    }
}
